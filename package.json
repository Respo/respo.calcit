{
  "dependencies": {
    "@calcit/procs": "0.29.0-alpha.27"
  },
  "scripts": {
    "test-persisted-tasks": "calcit js && node --test test/persisted-tasks.test.mjs",
    "test-render-traversal": "calcit --init-fn respo.test.dom/fixture-entry! --reload-fn respo.test.dom/fixture-entry! js && node --test test/component-listener-traversal.test.mjs test/event-node-lookup.test.mjs test/purify-render-node.test.mjs test/typed-dom-creation.test.mjs test/typed-effect-traversal.test.mjs test/typed-event-refresh.test.mjs",
    "test-callback-types": "node --test test/callback-type-boundaries.test.mjs",
    "test-event-config": "calcit js && node --test test/event-config.test.mjs",
    "test-demo-scheduler": "calcit js && node --test test/demo-scheduler.test.mjs",
    "test": "calcit calcit.cirru test --require-match --summary-only --format json",
    "test-ssr": "calcit js && node --test test/ssr-css.test.mjs",
    "test-dom-patch-types": "bash scripts/check-dom-patch-types.sh",
    "test-dom-host": "calcit --init-fn respo.test.dom/main! --reload-fn respo.test.dom/verify-dom-regressions! calcit.cirru js && node test-dom.mjs && node --test test/canvas-context.test.mjs",
    "test-keyed-moves": "calcit js && node --test test/keyed-moves.test.mjs",
    "test-cursor-keys": "calcit js && node --test test/cursor-keys.test.mjs",
    "bench-keyed-moves": "calcit js && node test/keyed-moves-bench.mjs",
    "check-docs": "bash scripts/check-docs-md.sh",
    "check-quality": "calcit calcit.cirru analyze quality --baseline config/calcit-quality.cirru",
    "check-framework-types": "bash scripts/check-framework-types.sh",
    "test-nominal-accessors": "bash scripts/check-nominal-accessors.sh",
    "test-patch-lookup": "calcit js && node --test test/patch-lookup.test.mjs",
    "bench-render": "calcit js && node test/render-performance-bench.mjs",
    "test-memo": "calcit js && node --test test/memo.test.mjs",
    "bench-memo": "calcit js && node test/memo-bench.mjs"
  },
  "devDependencies": {
    "bottom-tip": "^0.1.5",
    "vite": "^8.2.2"
  },
  "packageManager": "yarn@4.18.0"
}

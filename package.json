{
  "dependencies": {
    "@calcit/procs": "0.14.0"
  },
  "scripts": {
    "test": "calcit calcit.cirru --compat-types test --require-match --summary-only --format json",
    "test-dom-patch-types": "bash scripts/check-dom-patch-types.sh",
    "test-dom-host": "calcit --compat-types --init-fn respo.test.dom/main! calcit.cirru js && node test-dom.mjs",
    "check-docs": "bash scripts/check-docs-md.sh",
    "check-quality": "calcit calcit.cirru analyze quality --baseline config/calcit-quality.cirru"
  },
  "devDependencies": {
    "bottom-tip": "^0.1.5",
    "vite": "^8.2.2"
  },
  "packageManager": "yarn@4.12.0"
}
